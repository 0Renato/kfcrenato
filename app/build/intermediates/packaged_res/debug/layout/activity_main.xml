<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/header_main"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/kfc_red"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:src="@drawable/logokfc"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name" />

        <ImageButton
            android:id="@+id/btnMainCart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_carrinho_nav"
            android:contentDescription="Carrinho"
            app:tint="@color/kfc_white" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_main"
        android:layout_above="@id/bottom_navigation"
        xmlns:tools="http://schemas.android.com/tools"
        tools:layout="@layout/fragment_home" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/kfc_white"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/kfc_red"
        app:itemTextColor="@color/kfc_red"
        app:elevation="8dp" />

</RelativeLayout>