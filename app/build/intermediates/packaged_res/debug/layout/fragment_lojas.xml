<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Fragmento do Google Maps -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".LojasFragment" />

    <!-- Card informativo com botão e coordenadas GPS -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="top"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLojasTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lojas_title"
                android:textColor="@color/kfc_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLojasStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/lojas_status_loading"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp" />

            <!-- TextView que exibe as Coordenadas GPS (Lat: ... | Long: ...) -->
            <TextView
                android:id="@+id/textGps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/gps_aguardando"
                android:textColor="@color/kfc_black"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- Botão para obter/atualizar a localização -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPegarLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_pegar_localizacao"
                android:textSize="14sp"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>